import { useState, useEffect } from "react";
import { Link, useLocation } from "react-router-dom";
import { Button } from "@/components/ui/button";
import { Menu, X, Sun, Moon, Sparkles } from "lucide-react";
import { useTheme } from "next-themes";
import { 
  useSiteContent, 
  HeaderContent,
  defaultHeaderContent,
} from "@/hooks/useSiteContent";
import { useThemeLogo } from "@/hooks/useThemeLogo";

interface HeaderFooterContent {
  header: HeaderContent;
}

export const Navbar = () => {
  const [isOpen, setIsOpen] = useState(false);
  const [scrolled, setScrolled] = useState(false);
  const [mounted, setMounted] = useState(false);
  const location = useLocation();
  const { logoUrl, siteName } = useThemeLogo();
  const { data: headerFooterData } = useSiteContent<HeaderFooterContent>('header-footer');
  const { theme, setTheme, resolvedTheme } = useTheme();
  
  const header = headerFooterData?.header || defaultHeaderContent;

  useEffect(() => {
    setMounted(true);
  }, []);

  useEffect(() => {
    const handleScroll = () => {
      setScrolled(window.scrollY > 20);
    };
    window.addEventListener("scroll", handleScroll);
    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  useEffect(() => {
    setIsOpen(false);
  }, [location]);

  // Active link class
  const getActiveClass = (path: string) => {
    return location.pathname === path 
      ? "text-white after:absolute after:border-primary after:border-b-2 after:w-full after:bottom-0" 
      : "text-muted-foreground hover:text-white";
  };

  return (
    <nav
      className={`fixed top-0 left-0 right-0 z-50 transition-all duration-500 ${scrolled ? "bg-gradient-to-r from-gray-900/95 to-gray-800/95 via-[#0a0404]/95 to-[#050202]/95 backdrop-blur-2xl border-b border-gray-700/30 shadow-2xl shadow-gray-900/20" : "bg-gradient-to-r from-gray-900/80 to-gray-800/80 via-[#0a0404]/80 to-[#050202]/80 backdrop-blur-2xl border-b border-gray-700/20"}`}
    >
      <div className="container mx-auto px-4 sm:px-6">
        <div className="flex items-center justify-between h-16 sm:h-20 lg:h-24">
          {/* Logo - Always visible */}
          <Link to="/" className="flex items-center gap-2 flex-shrink-0 group cursor-spot">
            <div className="transition-transform duration-500 group-hover:scale-105">
              <img 
                src={logoUrl || "https://dsuvcvbtxdftlbhuvsnv.supabase.co/storage/v1/object/public/site-assets/logos/logo-light-1767101176264.png"} 
                alt={siteName} 
                className="h-10 sm:h-12 max-w-[160px] sm:max-w-[200px] object-contain transition-all duration-300 group-hover:scale-105"
              />
            </div>
            <div className="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-gradient-to-r from-primary/20 to-accent/20 border border-primary/30">
              <Sparkles className="h-4 w-4 sm:h-5 sm:w-5 text-primary" />
              <span className="text-sm font-display font-bold text-white tracking-wide">{siteName}</span>
            </div>
          </Link>

          {/* Desktop Navigation */}
          <div className="hidden lg:flex items-center gap-1 xl:gap-2">
            {header.navLinks.map((link) => (
              <Link
                key={link.id}
                to={link.path}
                className={`relative px-3.5 py-2 rounded-xl text-sm font-medium transition-all duration-300 group ${getActiveClass(link.path)}`}
              >
                <span className="flex items-center gap-2">
                  {link.name}
                  <span className={`absolute bottom-0 left-1/2 -translate-x-1/2 h-0.5 rounded-full transition-all duration-300 ${location.pathname === link.path ? "w-8 bg-gradient-to-r from-primary to-accent" : "w-0 group-hover:w-8 bg-primary/20"}`} />
                </span>
              </Link>
            ))}
          </div>

          {/* Theme Toggle & CTA Button */}
          <div className="hidden lg:flex items-center gap-3 flex-shrink-0">
            {mounted && (
              <button
                onClick={() => setTheme(resolvedTheme === 'dark' ? 'light' : 'dark')}
                className={`p-2.5 rounded-xl transition-all duration-300 cursor-spot ${scrolled ? "bg-secondary/50 hover:bg-secondary/70 text-muted-foreground hover:text-foreground" : "text-muted-foreground hover:text-foreground"}`}
                aria-label="Toggle theme"
              >
                {resolvedTheme === 'dark' ? (
                  <Sun className="h-5 w-5 text-amber-500" />
                ) : (
                  <Moon className="h-5 w-5 text-blue-500" />
                )}
              </button>
            )}
            <Button 
              variant="gradient" 
              size="default" 
              className="h-10 !py-3 text-sm font-semibold"
              asChild
            >
              <Link to={header.ctaLink}>{header.ctaText}</Link>
            </Button>
          </div>

          {/* Mobile Menu Button */}
          <button
            className="lg:hidden p-2.5 -mr-2 cursor-spot"
            onClick={() => setIsOpen(!isOpen)}
            aria-label="Toggle menu"
          >
            {isOpen ? (
              <X className="h-6 w-6 text-foreground" />
            ) : (
              <Menu className="h-6 w-6 text-foreground" />
            )}
          </button>
        </div>
      </div>

      {/* Mobile Menu */}
      <div
        className={`lg:hidden overflow-hidden transition-all duration-500 ${isOpen ? "max-h-[500px] bg-card/95 backdrop-blur-xl border-b border-border/30" : "max-h-0 bg-transparent border-b border-transparent"}`}
      >
        <div className="container mx-auto px-4 sm:px-6 py-4 flex flex-col gap-1">
          {header.navLinks.map((link) => (
            <Link
              key={link.id}
              to={link.path}
              className={`text-base font-medium py-3 px-3 rounded-xl transition-all duration-200 ${location.pathname === link.path ? "text-white bg-primary/10 border border-primary/20" : "text-muted-foreground hover:text-foreground hover:bg-secondary"}`}
            >
              {link.name}
            </Link>
          ))}
          <div className="flex items-center gap-3 mt-3 pt-3 border-t border-border/20">
            {mounted && (
              <button
                onClick={() => setTheme(resolvedTheme === 'dark' ? 'light' : 'dark')}
                className={`p-3 rounded-xl transition-all duration-300 cursor-spot ${scrolled ? "bg-secondary/50" : "bg-secondary/30"}`}
                aria-label="Toggle theme"
              >
                {resolvedTheme === 'dark' ? (
                  <Sun className="h-5 w-5 text-amber-500" />
                ) : (
                  <Moon className="h-5 w-5 text-blue-500" />
                )}
              </button>
            )}
            <Button variant="gradient" className="flex-1" asChild>
              <Link to={header.ctaLink}>{header.ctaText}</Link>
            </Button>
          </div>
        </div>
      </div>
    </nav>
  );
};
