import { Link } from "react-router-dom";
import { Button } from "@/components/ui/button";
import { ArrowRight, Play, Sparkles } from "lucide-react";
import { useSiteContent, defaultHomepageHero, HomepageContent } from "@/hooks/useSiteContent";
import { motion } from "framer-motion";

export const HeroSection = () => {
  const { data } = useSiteContent<HomepageContent>('homepage');
  const hero = data?.hero || defaultHomepageHero;

  return (
    <section className="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-hero">
      {/* ── Animated background layers ── */}
      <div className="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        {/* Gradient orbs */}
        <motion.div
          animate={{ scale: [1, 1.15, 1], opacity: [0.3, 0.5, 0.3], x: [0, 30, 0], y: [0, -20, 0] }}
          transition={{ duration: 8, repeat: Infinity, ease: "easeInOut" }}
          className="absolute top-[-20%] left-[-10%] w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px]"
        />
        <motion.div
          animate={{ scale: [1, 1.15, 1], opacity: [0.3, 0.5, 0.3], x: [0, -20, 0], y: [0, 20, 0] }}
          transition={{ duration: 9, repeat: Infinity, ease: "easeInOut", delay: 1 }}
          className="absolute bottom-[-10%] right-[-10%] w-[450px] h-[450px] bg-accent/10 rounded-full blur-[120px]"
        />
        <motion.div
          animate={{ opacity: [0.2, 0.4, 0.2], scale: [1, 1.05, 1] }}
          transition={{ duration: 6, repeat: Infinity, ease: "easeInOut", delay: 2 }}
          className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[150px]"
        />

        {/* Floating geometric shapes */}
        <motion.div
          animate={{ y: [0, -20, 0], rotate: [0, 8, 0], scale: [1, 1.05, 1] }}
          transition={{ duration: 6, repeat: Infinity, ease: "easeInOut" }}
          className="absolute top-1/3 left-1/4 w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-primary/5 border border-primary/10 float-slow"
        />
        <motion.div
          animate={{ y: [0, 20, 0], rotate: [0, -10, 0], scale: [1, 1.05, 1] }}
          transition={{ duration: 5, repeat: Infinity, ease: "easeInOut", delay: 0.5 }}
          className="absolute top-1/2 right-1/4 w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-accent/5 border border-accent/10 float-slow"
        />
        <motion.div
          animate={{ y: [0, -12, 0], rotate: [0, 5, 0], scale: [1, 1.03, 1] }}
          transition={{ duration: 7, repeat: Infinity, ease: "easeInOut", delay: 1 }}
          className="absolute bottom-1/3 left-1/5 w-12 h-12 sm:w-16 sm:h-16 rounded-xl bg-primary/10 border border-primary/5 float-slow"
        />
        <motion.div
          animate={{ y: [0, 15, 0], rotate: [0, -6, 0], scale: [1, 1.03, 1] }}
          transition={{ duration: 6, repeat: Infinity, ease: "easeInOut", delay: 1.5 }}
          className="absolute bottom-1/4 right-1/5 w-14 h-14 sm:w-18 sm:h-18 rounded-lg bg-accent/8 border border-accent/10 float-slow"
        />

        {/* Grid overlay */}
        <div className="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:60px_60px]" aria-hidden="true" />
      </div>

      {/* ── Content ── */}
      <div className="container mx-auto px-4 sm:px-6 pt-24 sm:pt-28 md:pt-20 pb-16 relative z-10">
        <motion.div
          initial={{ opacity: 0, y: 30 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          className="max-w-4xl mx-auto text-center"
        >
          {/* Badge */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.6, delay: 0.1 }}
            className="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-border/40 bg-secondary/30 backdrop-blur-sm mb-6 sm:mb-8"
          >
            <motion.span
              animate={{ scale: [1, 1.15, 1] }}
              transition={{ duration: 2, repeat: Infinity }}
              className="w-2 h-2 rounded-full bg-gradient-to-r from-primary to-accent"
            />
            <span className="text-xs sm:text-sm font-medium text-muted-foreground tracking-wide uppercase">
              {hero.badge}
            </span>
          </motion.div>

          {/* H1 */}
          <motion.h1
            initial={{ opacity: 0, y: 30 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.7, delay: 0.15 }}
            className="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-7xl font-display font-bold leading-tight mb-4 sm:mb-6 px-2"
          >
            {hero.title}
            <span className="text-gradient">{hero.titleHighlight}</span>
          </motion.h1>

          {/* Subheadline */}
          <motion.p
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.7, delay: 0.3 }}
            className="text-base sm:text-lg md:text-xl lg:text-xl text-muted-foreground max-w-2xl mx-auto mb-8 sm:mb-10 px-4 leading-relaxed"
          >
            {hero.description}
          </motion.p>

          {/* CTA Buttons */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.7, delay: 0.45 }}
            className="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 px-4"
          >
            <motion.div
              whileHover={{ scale: 1.03, y: -2 }}
              whileTap={{ scale: 0.98 }}
              className="hover-lift"
            >
              <Button
                variant="gradient"
                size="lg"
                className="w-full sm:w-auto text-sm sm:text-base h-12"
                asChild
              >
                <Link to={hero.primaryButtonLink || '/contact'}>
                  {hero.primaryButtonText}
                  <ArrowRight className="ml-2 h-4 w-4 sm:h-5 sm:w-5" />
                </Link>
              </Button>
            </motion.div>
            <motion.div
              whileHover={{ scale: 1.03, y: -2 }}
              whileTap={{ scale: 0.98 }}
              className="hover-lift"
            >
              <Button
                variant="glass"
                size="lg"
                className="w-full sm:w-auto text-sm sm:text-base h-12"
                asChild
              >
                <Link to={hero.secondaryButtonLink || '/projects'}>
                  <Play className="mr-2 h-4 w-4 sm:h-5 sm:w-5" />
                  {hero.secondaryButtonText}
                </Link>
              </Button>
            </motion.div>
          </motion.div>

          {/* Stats */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.7, delay: 0.6 }}
            className="grid grid-cols-3 gap-3 sm:gap-6 md:gap-8 mt-12 sm:mt-16 md:mt-20 pt-8 sm:pt-10 border-t border-border/30"
          >
            {hero.stats.map((stat, index) => (
              <motion.div
                key={stat.label}
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.7 + index * 0.1, duration: 0.5 }}
                className="text-center"
              >
                <motion.div
                  whileHover={{ scale: 1.08 }}
                  className="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-display font-bold text-gradient mb-1 sm:mb-2 block"
                >
                  {stat.number}
                </motion.div>
                <div className="text-xs sm:text-sm text-muted-foreground tracking-wide">{stat.label}</div>
              </motion.div>
            ))}
          </motion.div>

          {/* Decorative sparkle */}
          <motion.div
            animate={{ scale: [1, 1.2, 1], opacity: [0.3, 0.6, 0.3] }}
            transition={{ duration: 4, repeat: Infinity, delay: 2.5 }}
            className="absolute top-10 left-10 hidden sm:block"
          >
            <Sparkles className="w-6 h-6 sm:w-8 sm:h-8 text-primary/20" />
          </motion.div>
        </motion.div>
      </div>

      {/* ── Scroll indicator ── */}
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ delay: 1.2, duration: 0.6 }}
        className="absolute bottom-6 sm:bottom-8 left-1/2 -translate-x-1/2 hidden sm:block"
      >
        <div className="w-6 h-8 sm:w-8 sm:h-10 rounded-full border-2 border-border/30 flex items-start justify-center p-1.5 sm:p-2 cursor-pointer">
          <motion.div
            animate={{ y: [0, 8, 0] }}
            transition={{ duration: 1.8, repeat: Infinity, ease: "easeInOut" }}
            className="w-1.5 h-3 sm:h-4 bg-gradient-to-b from-primary to-transparent rounded-full"
          />
        </div>
      </motion.div>
    </section>
